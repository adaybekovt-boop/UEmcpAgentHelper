{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [{"type": "command", "command": "{UED} hook pre-tool", "timeout": 10,
                   "statusMessage": "UE-Direct: checking for fake native assets"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [{"type": "command", "command": "{UED} hook post-tool", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "{UED} hook stop", "timeout": 30,
                   "statusMessage": "UE-Direct: completion gate"}]
      }
    ]
  }
}
