{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [{"type": "command", "command": "{HOOK:pre-tool}", "timeout": 10,
                   "statusMessage": "UE-Direct: checking for fake native assets"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [{"type": "command", "command": "{HOOK:post-tool}", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "{HOOK:stop}", "timeout": 30,
                   "statusMessage": "UE-Direct: completion gate"}]
      }
    ]
  }
}
