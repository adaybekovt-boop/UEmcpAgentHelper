{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{"type": "command", "command": "{HOOK:pre-tool}", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [{"type": "command", "command": "{HOOK:post-tool}", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "{HOOK:stop}", "timeout": 30}]
      }
    ]
  }
}
